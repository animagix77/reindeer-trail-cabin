# Track only the tour, its editable sources, and the inputs used to rebuild it.
*
!/.gitignore
!/.gitattributes
!/README.md
!/Explore the property.html
!/Reindeer Trail.blend
!/Reindeer Trail.glb
!/Reference/
!/Reference/*.py
!/Reference/model-geometry.json
!/Reference/lidar-parcel.csv
!/Reference/terrain-provenance.json
!/Reference/lidar-provenance.json
!/Reference/State aerial.jpg
!/Reference/Exterior materials/
!/Reference/Exterior materials/*.jpg
!/Reference/Exterior materials/*.png
!/Reference/Interior materials/
!/Reference/Interior materials/*.jpg
!/Reference/Interior materials/*.png
!/Reference/Woodland context/
!/Reference/Woodland context/Woodland canopy.json
!/Reference/Woodland context/Neighboring homes.json
!/Reference/Woodland context/Woodland heights.npz
!/Reference/Woodland context/Neighboring homes.json
!/Reference/Woodland context/Woodland terrain.jpg
!/Reference/Woodland context/Hardwood silhouettes.png
!/Reference/viewer-src/
!/Reference/viewer-src/*.js
!/Reference/viewer-src/*.mjs
!/Reference/viewer-src/*.css
!/Reference/viewer-src/package.json
!/Reference/viewer-src/package-lock.json
!/Reference/viewer-src/template.html
!/Reference/viewer-src/THREE-LICENSE.txt
!/Reference/viewer-src/Barlow-OFL.txt
!/Reference/viewer-src/BarlowCondensed-SemiBold.ttf

!/Reference/Property aerial.jpg
!/Reference/Neighborhood satellite.jpg
!/Reference/Map layers.json
!/Reference/map-provenance.json
!/Reference/Woodland context/Summer vegetation.json
!/Reference/viewer-src/welcome-yard.webp
!/Reference/viewer-src/hiker-man.png
!/Reference/viewer-src/hiker-woman.png
!/.github/
!/.github/workflows/
!/.github/workflows/pages.yml
!/Reference/viewer-src/hipparcos-bright.json
